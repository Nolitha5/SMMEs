# Shared application
PORT=8790
BUSINESS_ID=dev-business
WEB_ORIGIN=http://localhost:5174

# Local development may use local auth only. Production refuses local auth.
AUTH_MODE=local

# Firebase Admin API connection.
FIREBASE_PROJECT_ID=sme-agent-platform-dev
# Keep credentials outside the repo. Example only:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YourName/Documents/firebase-keys/sme-agent-platform-dev-admin.json

# Web application
VITE_API_BASE_URL=http://localhost:8790/api
VITE_BUSINESS_ID=dev-business
VITE_AUTH_MODE=local

# Required when VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sme-agent-platform-dev
VITE_FIREBASE_APP_ID=
