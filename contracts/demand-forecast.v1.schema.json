{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sme-agent-platform.local/contracts/demand-forecast.v1.schema.json",
  "title": "DemandForecastV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "product_id",
    "horizon_days",
    "expected_qty",
    "lower_bound",
    "upper_bound",
    "confidence",
    "drivers",
    "generated_at",
    "source_version"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1
    },
    "expected_qty": {
      "type": "number",
      "minimum": 0
    },
    "lower_bound": {
      "type": "number",
      "minimum": 0
    },
    "upper_bound": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": [
        "string",
        "object"
      ]
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
