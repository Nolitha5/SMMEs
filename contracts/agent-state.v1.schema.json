{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sme-agent-platform.local/contracts/agent-state.v1.schema.json",
  "title": "AgentStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateId",
    "businessId",
    "outputId",
    "capabilityId",
    "sourceAgent",
    "domain",
    "outputType",
    "entityType",
    "entityId",
    "payload",
    "confidence",
    "riskLevel",
    "generatedAt",
    "modelOrRuleVersion",
    "contractVersion",
    "schemaVersion"
  ],
  "properties": {
    "stateId": {
      "type": "string",
      "minLength": 1
    },
    "businessId": {
      "type": "string",
      "minLength": 1
    },
    "outputId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[DIPRC][1-5]$"
    },
    "sourceAgent": {
      "type": "string",
      "enum": [
        "demand",
        "inventory",
        "pricing",
        "procurement",
        "customer-engagement"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "demand",
        "inventory",
        "pricing",
        "procurement",
        "customer-engagement"
      ]
    },
    "outputType": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "riskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "generatedAt": {
      "type": [
        "string",
        "object"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "modelOrRuleVersion": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 4
    }
  }
}
