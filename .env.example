APP_NAME=Retail Procurement Agent
APP_ENV=development
APP_VERSION=1.0.0
AUTH_MODE=demo
REPOSITORY_BACKEND=memory
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_JSON=
CORS_ORIGINS=http://localhost:5173
DEMO_MANAGER_EMAIL=manager@example.com
RECOMMENDATION_TTL_HOURS=24
SUPPLIER_QUOTE_TTL_DAYS=30
MAX_PO_VALUE_WITHOUT_SECOND_REVIEW=25000

# DEV/TEST ONLY. Lets Procurement publish D4/I1/I2/I3 contracts on the upstream
# agents' behalf so it can run standalone. Procurement is NOT their producer:
# set this to false in the shared system, where Demand and Inventory publish them.
ALLOW_UPSTREAM_FIXTURES=true
