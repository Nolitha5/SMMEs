# Flask
SECRET_KEY=change-me-to-a-long-random-secret

# SQLite
DATABASE_PATH=price_agent.db

# Background price refresh
CHECK_INTERVAL_HOURS=6
ENABLE_BACKGROUND_CHECKER=true

# Server
PORT=5000

# Gemini API
# Current default: gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase Web config as one JSON object.
# Example: {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
FIREBASE_CONFIG_JSON=

# Optional Firebase Admin service-account JSON file for server-side token verification.
FIREBASE_SERVICE_ACCOUNT=
